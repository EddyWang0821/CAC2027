# Relay tries these providers/keys in order, top to bottom, until one
# works — so a request only fails if every single one of them fails.
# You only need ONE section below filled in to run the app. Fill in more
# for redundancy against rate limits, an exhausted quota, or an outage.

# --- Google Gemini (recommended primary) ---
# Free, no credit card: aistudio.google.com/apikey
# Add more than one key, comma-separated, to fall back to key 2 automatically
# if key 1 hits its rate limit or runs out of quota for the day.
GEMINI_API_KEYS=your_key_here,your_second_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (free fallback, no credit card) ---
# console.groq.com/keys
# Groq's free-tier vision model changes fairly often (they rotate preview
# models) — if requests fail here, check console.groq.com/docs/vision for
# the current one and update GROQ_MODEL.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# --- OpenRouter (free fallback, no credit card, self-updating) ---
# openrouter.ai/keys
# "openrouter/free" is a router, not a fixed model — it automatically picks
# whichever currently-free model on OpenRouter supports image input, so
# this keeps working even as individual free models get added or retired.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

PORT=3000
